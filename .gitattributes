# Normalize line endings in the repo; check out as-is on each platform.
* text=auto

# Scripts and configs that must stay LF
*.sh text eol=lf
*.ps1 text
*.yml text
*.yaml text
*.json text
*.md text

# Binary assets
*.png binary
*.glb binary
*.stl binary
*.pdf binary
*.SLDPRT binary
*.SLDASM binary
*.SLDDRW binary
*.sldprt binary
*.sldasm binary
*.slddrw binary
*.step binary
*.stp binary

# Vendored npm artifacts are pinned by SHA-256; never normalise their line endings.
extractor/SwReview.AddIn/Terminal/TerminalPage/vendor/* -text

# A recorded event-stream sample pinned byte for byte by both test suites; never normalise it.
*.sse -text

# The inputs a run digests over raw bytes check out with LF everywhere, so two machines' digests
# agree (specs/014-design-review-eval/contracts/provenance.md 6.5). `eol` sets only a text file's
# checkout ending: the binary rules above keep their -text.
config/standards.example.yaml eol=lf
reviewer/src/swreview/agent/checklist_v1.yaml eol=lf
reviewer/src/swreview/agent/prompts/*.md eol=lf
benchmarks/** eol=lf
# The packed event streams a committed run folder holds (provenance.md 6.6); after the rule above,
# so the later line wins and no checkout converts a compressed byte.
*.gz binary
