<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SwReview.AddIn.Tests</RootNamespace>
    <AssemblyName>SwReview.AddIn.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- The add-in's Task Pane control is a WinForms UserControl, so the tests that
         construct it need the WinForms reference set too (SwReview.AddIn.csproj). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Same validator and version SwReview.Extractor.Tests uses for contracts/ir.schema.json. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwReview.AddIn\SwReview.AddIn.csproj" />
    <ProjectReference Include="..\SwReview.Extractor\SwReview.Extractor.csproj" />
  </ItemGroup>

  <!--
    T048: `IToolService.Session` is an `ISwSession`, whose members are interop types, so a test
    fake for it has to name them. A `<Reference>` does not flow through a ProjectReference, so
    the seat's interops are stated here as well. No new build requirement: SwReview.AddIn cannot
    compile without them either.

    `Private` is true here where SwReview.AddIn.csproj sets it false, and the difference is the
    point: the add-in must not ship a copy of the seat's interops, but the test host has to be
    able to *load* them - the JIT resolves SolidWorks.Interop.sldworks the moment it prepares a
    fake that implements ISwSession, and a missing assembly there surfaces as a start that
    silently never happened rather than as a build error.

    swpublished is here for the same reason: `SwReviewAddIn` implements `ISwAddin`, which lives
    in that assembly, so AddInComCallbackTests cannot so much as name the add-in type without
    it (docs/addin-load-fix.md, cause 1).
  -->
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    The settings contract is the single source of truth
    (specs/002-task-pane-assistant/contracts/settings.schema.json). It is copied, not
    duplicated, so a schema change breaks UserSettingsTests immediately.
  -->
  <ItemGroup>
    <Content Include="..\..\specs\002-task-pane-assistant\contracts\settings.schema.json" Link="settings.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Same reason, for the two contracts ReviewPageContractTests (T042) reads as data: the
      page-to-host message tables, and the chat event `type` enum the page also handles.
    -->
    <Content Include="..\..\specs\002-task-pane-assistant\contracts\pane-host-messages.md" Link="pane-host-messages.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\specs\002-task-pane-assistant\contracts\chat-events.schema.json" Link="chat-events.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      And for CliProfileWriterTests (T056), which compares the generated Codex config.toml
      with this file's own fenced block byte-for-byte: the contract is the expected value,
      not a second copy of it in the test.
    -->
    <Content Include="..\..\specs\002-task-pane-assistant\contracts\cli-profiles.md" Link="cli-profiles.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      And for ModelCheckPageTests (T081), which reads the tab-4 message tables out of the
      feature 003 contract the same way.
    -->
    <Content Include="..\..\specs\003-resilient-modeling\contracts\model-check.md" Link="model-check.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      T061a. The CLI tool listings ToolListingCheckTests parses: real captures from
      codex-cli 0.115.0, and hand-authored Gemini `/mcp` transcripts while that terminal is
      deferred. Fixtures\ToolListing\README.md records where each one came from and how to
      take the Codex ones again; it is deliberately not copied, because it is documentation
      for the reader of the repository rather than data for the test.
    -->
    <Content Include="Fixtures\ToolListing\*.json;Fixtures\ToolListing\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
