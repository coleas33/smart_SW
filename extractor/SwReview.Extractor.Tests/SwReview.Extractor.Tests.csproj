<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SwReview.Extractor.Tests</RootNamespace>
    <AssemblyName>SwReview.Extractor.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwReview.Extractor\SwReview.Extractor.csproj" />
    <!-- The console host's argument parsing is pure logic and is unit tested (T059). -->
    <ProjectReference Include="..\SwReview.Extractor.Console\SwReview.Extractor.Console.csproj" />
  </ItemGroup>

  <!--
    The IR contract is the single source of truth (specs/.../contracts/ir.schema.json).
    It is copied, not duplicated, so a schema change breaks this test immediately (T105).
  -->
  <ItemGroup>
    <Content Include="..\..\specs\001-agentic-design-review\contracts\ir.schema.json" Link="ir.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    T055. The frozen interop-surface manifest (specs/004-.../contracts/interop-manifest.md).
    Generated once by reflection over SOLIDWORKS 2024 SP5 interop 32.5.0.48 and checked in;
    regenerating it is a deliberate, reviewed commit and never something a test does.
  -->
  <ItemGroup>
    <Content Include="Fixtures\InteropSurface\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    T014. The bytes PackageSerializer wrote for IrSerializerTests.BuildSamplePackage under
    schema 1.3.0, captured from that build and thereafter static. It is what makes "a package
    carrying none of feature 006's evidence serializes exactly as it did" a measurement rather
    than an inspection (contracts/ir-additions.md additivity rule point 5).
  -->
  <ItemGroup>
    <Content Include="Fixtures\package-pre-1.4.0.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    T019. research.md R8's table is the count of the members feature 006 denies, and the guard
    test derives its expected set from that table's membership rather than transcribing it. So
    the document is copied, not duplicated - the same arrangement as ir.schema.json above -
    and a row added to R8 without a matching entry in ReadOnlyGuard is a red test.
  -->
  <ItemGroup>
    <Content Include="..\..\specs\006-standards-check\research.md" Link="standards-research.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
