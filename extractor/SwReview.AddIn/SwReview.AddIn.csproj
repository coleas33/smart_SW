<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SwReview.AddIn</RootNamespace>
    <AssemblyName>SwReview.AddIn</AssemblyName>
    <Description>In-process SOLIDWORKS add-in host for the SwReview extractor.</Description>
    <!-- regasm needs a COM-visible assembly; see SwReviewAddIn.cs for the registration steps. -->
    <EnableComHosting>false</EnableComHosting>
    <!-- The Task Pane is a WinForms UserControl (T060). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwReview.Extractor\SwReview.Extractor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SwRedist)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      WebView2 hosts both Task Pane pages (plan.md: "Microsoft.Web.WebView2 (NuGet,
      WebView2Loader.dll shipped next to the add-in)"). Pinned: an add-in loaded into
      SOLIDWORKS cannot float its native loader.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!--
      Settings/UserSettings.cs reads and writes %APPDATA%\SwReview\settings.json directly, so
      the reference is stated here rather than inherited through SwReview.Extractor; the
      version is pinned to the extractor's so one copy ships. DPAPI (ProtectedData) is in the
      .NET Framework's System.Security assembly, which is a framework reference, not a package.
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The chat and terminal pages are plain vendored HTML/JS with no build step
      (plan.md, Structure Decision). They are copied under the add-in's `web` folder,
      which is the folder SetVirtualHostNameToFolderMapping("swreview.invalid", ...)
      maps, so the page origin is https://swreview.invalid (contracts/pane-host-messages.md).
      Source layout is preserved below `web` so `vendor/` subfolders land intact.
    -->
    <Content Include="Review\ReviewPage\**\*">
      <Link>web\Review\ReviewPage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Terminal\TerminalPage\**\*">
      <Link>web\Terminal\TerminalPage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Model\ModelCheckPage\**\*">
      <Link>web\Model\ModelCheckPage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Standards\StandardsPage\**\*">
      <Link>web\Standards\StandardsPage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Remodel\RemodelPage\**\*">
      <Link>web\Remodel\RemodelPage\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      `web/shared/` is authored where it is served from, because it belongs to no one page:
      both pages load `shared/dom.js` from the same virtual host so the "insert every
      untrusted string with createTextNode" rule has one copy (T080). No Link element, so the
      source layout is the published layout.
    -->
    <Content Include="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      The Task Pane tab icon, one PNG per size CreateTaskpaneView3 wants (TaskPaneIcons.cs).
      Read from beside the add-in at load, so copied like the pages; TaskPaneIconsTests
      opens each one from the output folder, so a size that stopped copying fails the build's
      tests rather than showing as the stock icon on the workstation.
    -->
    <Content Include="Icons\*.png" Exclude="Icons\taskpane-source-512.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      The general-chat persona (T057). Embedded rather than copied beside the add-in:
      CliProfileWriter writes it into the generated Codex home on every terminal start, and
      Codex *replaces* its system prompt with that file, so a persona that had gone missing
      from the output folder would be a CLI running with its stock instructions and no
      read-only rule at all. An embedded resource cannot go missing from a loaded assembly.
    -->
    <EmbeddedResource Include="Terminal\Profiles\codex-instructions.md">
      <LogicalName>SwReview.AddIn.Terminal.Profiles.codex-instructions.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The NuGet package copies the native loader to runtimes\win-x64\native\WebView2Loader.dll
    and Microsoft.Web.WebView2.Core.dll probes that folder relative to its own location. The
    add-in is regasm-registered and loaded into SLDWORKS.exe, and plan.md requires the loader
    "shipped next to the add-in", so put a flat copy in the output folder too - both probe
    locations are then satisfied whatever SOLIDWORKS does to assembly resolution. The Error
    turns a package layout change into a build failure instead of a runtime failure inside
    SOLIDWORKS, where a missing loader surfaces only as the fallback panel (T042b).
  -->
  <Target Name="CopyWebView2LoaderBesideAddIn" AfterTargets="Build">
    <ItemGroup>
      <WebView2LoaderNative Include="@(ContentWithTargetPath)"
                            Condition="'%(ContentWithTargetPath.TargetPath)' == 'runtimes\win-x64\native\WebView2Loader.dll'" />
    </ItemGroup>
    <Error Condition="'@(WebView2LoaderNative)' == ''"
           Text="Microsoft.Web.WebView2 did not supply an x64 WebView2Loader.dll; check the pinned package version." />
    <Copy SourceFiles="@(WebView2LoaderNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
