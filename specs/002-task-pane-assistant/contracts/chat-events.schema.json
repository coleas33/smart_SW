{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sw.local/contracts/chat-events.schema.json",
  "title": "ChatEvent",
  "description": "One line of events.jsonl and one server-sent event. Bodies reuse feature 001 review-session definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "type", "body"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["session.started", "text.delta", "text.done", "tool.started", "tool.finished", "finding", "evidence.requested", "evidence.answered", "disposition", "coverage", "turn.ended", "session.ended", "error"]
    },
    "body": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "session.started" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["session_id", "package_id", "provider", "model", "effort_mapping"],
        "properties": { "session_id": { "type": "string" }, "package_id": { "type": "string" }, "provider": { "enum": ["openai", "gemini", "fake"] }, "model": { "type": "string" },
          "effort_mapping": { "type": "object", "additionalProperties": false, "required": ["requested", "provider_param", "provider_value"], "properties": { "requested": { "type": "string" }, "provider_param": { "type": "string" }, "provider_value": { "type": ["string", "integer"] } } } } } } } },
    { "if": { "properties": { "type": { "enum": ["text.delta", "text.done"] } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } } } } },
    { "if": { "properties": { "type": { "const": "tool.started" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["step_index", "tool", "arguments"],
        "properties": { "step_index": { "type": "integer" }, "tool": { "type": "string" }, "arguments": { "type": "object" } } } } } },
    { "if": { "properties": { "type": { "const": "tool.finished" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["step_index", "status", "result_summary", "elapsed_s", "error"],
        "properties": { "step_index": { "type": "integer" }, "status": { "enum": ["ok", "error"] }, "result_summary": { "type": "string" }, "elapsed_s": { "type": "number" }, "error": { "type": ["string", "null"] } } } } } },
    { "if": { "properties": { "type": { "const": "finding" } } },
      "then": { "properties": { "body": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Finding" } } } },
    { "if": { "properties": { "type": { "const": "evidence.requested" } } },
      "then": { "properties": { "body": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/EvidenceRequest" } } } },
    { "if": { "properties": { "type": { "const": "evidence.answered" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["request_id", "answer"], "properties": { "request_id": { "type": "string" }, "answer": { "type": "string" } } } } } },
    { "if": { "properties": { "type": { "const": "disposition" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["finding_id", "disposition"],
        "properties": { "finding_id": { "type": "string" }, "disposition": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Disposition" } } } } } },
    { "if": { "properties": { "type": { "const": "coverage" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["bucket", "item"],
        "properties": { "bucket": { "enum": ["checked", "skipped", "unresolved", "failed", "out_of_scope"] }, "item": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/CoverageItem" } } } } } },
    { "if": { "properties": { "type": { "const": "turn.ended" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "enum": ["end", "max_steps", "error", "stopped", "truncated"] } } } } } },
    { "if": { "properties": { "type": { "const": "session.ended" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["ended_at", "timing"],
        "properties": { "ended_at": { "type": "string", "format": "date-time" }, "timing": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Timing" } } } } } },
    { "if": { "properties": { "type": { "const": "error" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["error_class", "message", "retryable"],
        "properties": { "error_class": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } } } } }
  ]
}
