{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sw.local/contracts/chat-events.schema.json",
  "title": "ChatEvent",
  "description": "One line of events.jsonl and one server-sent event. Bodies reuse feature 001 review-session definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "at", "type", "body"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["session.started", "text.delta", "text.done", "tool.started", "tool.finished", "finding", "evidence.requested", "evidence.answered", "disposition", "coverage", "coverage.withdrawn", "usage", "turn.ended", "session.ended", "error"]
    },
    "body": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "session.started" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["session_id", "package_id", "provider", "model", "effort_mapping"],
        "properties": { "session_id": { "type": "string" }, "package_id": { "type": "string" }, "provider": { "enum": ["openai", "gemini", "fake"] }, "model": { "type": "string" },
          "effort_mapping": { "type": "object", "additionalProperties": false, "required": ["requested", "provider_param", "provider_value"], "properties": { "requested": { "type": "string" }, "provider_param": { "type": "string" }, "provider_value": { "type": ["string", "integer"] } } } } } } } },
    { "if": { "properties": { "type": { "enum": ["text.delta", "text.done"] } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } } } } },
    { "if": { "properties": { "type": { "const": "tool.started" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["step_index", "tool", "arguments"],
        "properties": { "step_index": { "type": "integer" }, "tool": { "type": "string" }, "arguments": { "type": "object" } } } } } },
    { "if": { "properties": { "type": { "const": "tool.finished" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["step_index", "status", "result_summary", "elapsed_s", "error"],
        "properties": { "step_index": { "type": "integer" }, "status": { "enum": ["ok", "error"] }, "result_summary": { "type": "string" }, "elapsed_s": { "type": "number" }, "error": { "type": ["string", "null"] } } } } } },
    { "if": { "properties": { "type": { "const": "finding" } } },
      "then": { "properties": { "body": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Finding" } } } },
    { "if": { "properties": { "type": { "const": "evidence.requested" } } },
      "then": { "properties": { "body": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/EvidenceRequest" } } } },
    { "if": { "properties": { "type": { "const": "evidence.answered" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["request_id", "answer"], "properties": { "request_id": { "type": "string" }, "answer": { "type": "string" } } } } } },
    { "if": { "properties": { "type": { "const": "disposition" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["finding_id", "disposition"],
        "properties": { "finding_id": { "type": "string" }, "disposition": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Disposition" } } } } } },
    { "if": { "properties": { "type": { "const": "coverage" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["bucket", "item"],
        "properties": { "bucket": { "enum": ["checked", "skipped", "unresolved", "failed", "out_of_scope"] }, "item": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/CoverageItem" } } } } } },
    { "if": { "properties": { "type": { "const": "coverage.withdrawn" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["checks", "buckets"],
        "description": "Feature 011 T092: every coverage item of these checks left each of these buckets, before the check restated its state. Emitted by ToolContext.withdraw_coverage, the one place an announced item leaves the session, and only when an item did; each check and each bucket once, in the order given. A reader of the stream drops the items whose check is in checks and whose bucket is in buckets, so it holds what the session holds; nothing identifies one coverage item with another.",
        "properties": { "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "buckets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["checked", "skipped", "unresolved", "failed", "out_of_scope"] } } } } } } },
    { "if": { "properties": { "type": { "const": "usage" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false,
        "description": "What one model round trip cost, emitted by the adapter once per request (feature 005). Every count is nullable because a field the endpoint omitted is unknown, not zero, and the two providers' sub-counts nest differently and are never summed across them. Required is every field: the event is new, so there is no older producer to keep valid.",
        "required": ["round_index", "provider", "model", "input_tokens", "cached_input_tokens", "cache_write_tokens", "output_tokens", "reasoning_tokens", "tool_result_input_tokens", "total_tokens", "latency_s", "cache_diagnostic"],
        "properties": {
          "round_index": { "type": "integer", "minimum": 0, "description": "The adapter's own per-turn counter, zero-based and reset each turn, the convention tool.started.step_index already uses. No turn number is carried: turns are delimited by the turn.ended events" },
          "provider": { "enum": ["openai", "gemini", "fake"] },
          "model": { "type": "string" },
          "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "OpenAI only; null on Gemini" },
          "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "tool_result_input_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Gemini only; the same tokens are already inside input_tokens on OpenAI" },
          "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "latency_s": { "type": "number", "minimum": 0, "description": "Wall clock of the one request, measured by the adapter. Never null" },
          "cache_diagnostic": { "type": ["object", "null"], "description": "OpenAI's prompt-cache outcome for this round, recorded verbatim; null on Gemini, null on fake, and null on OpenAI whenever prompt_cache_options.comparison_response_id was not sent" } } } } } },
    { "if": { "properties": { "type": { "const": "turn.ended" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "enum": ["end", "max_steps", "error", "stopped", "truncated"] } } } } } },
    { "if": { "properties": { "type": { "const": "session.ended" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["ended_at", "timing"],
        "properties": { "ended_at": { "type": "string", "format": "date-time" }, "timing": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/Timing" },
          "usage": { "$ref": "https://smart-sw.local/contracts/review-session.schema.json#/$defs/SessionUsage", "description": "What the session cost, summed under the one rule SessionUsage defines, so the pane does not own a second one (feature 005). Optional: absent when no round reported usage, and absent on every stream written before this feature" } } } } } },
    { "if": { "properties": { "type": { "const": "error" } } },
      "then": { "properties": { "body": { "type": "object", "additionalProperties": false, "required": ["error_class", "message", "retryable"],
        "properties": { "error_class": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } } } } }
  ]
}
