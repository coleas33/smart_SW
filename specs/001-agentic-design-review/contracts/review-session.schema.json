{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-sw.local/contracts/review-session.schema.json",
  "title": "ReviewSession",
  "description": "One run of the reviewer over one evidence package. Field rules: data-model.md section 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "package_id", "design_id", "started_at", "ended_at", "model", "steps", "evidence_requests", "findings", "coverage", "timing"],
  "properties": {
    "explanations_enabled": { "type": "boolean" },
    "finding_explanations": {
      "type": "object",
      "maxProperties": 5,
      "propertyNames": { "pattern": "^F-[0-9]+$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 480 }
    },
    "finding_explanation_fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "session_id": { "type": "string", "format": "uuid" },
    "package_id": { "type": "string", "format": "uuid" },
    "design_id": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "model": { "type": "string" },
    "provider_info": { "anyOf": [{ "$ref": "#/$defs/ProviderInfo" }, { "type": "null" }] },
    "retry_of": { "type": ["string", "null"], "format": "uuid" },
    "reused_from": { "type": ["string", "null"] },
    "efficiency": { "anyOf": [{ "$ref": "#/$defs/EfficiencySettings" }, { "type": "null" }] },
    "usage": { "anyOf": [{ "$ref": "#/$defs/SessionUsage" }, { "type": "null" }] },
    "withheld_checks": { "type": "array", "items": { "type": "string" }, "description": "Coverage checks closed out by a tool this run declined to offer (feature 005 lever 4, FR-054). Added to properties and left out of required, so a session written before the field existed still validates; empty for every run with tool_tiers off" },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/InvestigationStep" } },
    "evidence_requests": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRequest" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "timing": { "$ref": "#/$defs/Timing" }
  },
  "$defs": {
    "Quantity": { "$ref": "ir.schema.json#/$defs/Quantity" },
    "Angle": { "$ref": "ir.schema.json#/$defs/Angle" },
    "Dimension": { "$ref": "ir.schema.json#/$defs/Dimension" },
    "SourceRef": { "$ref": "ir.schema.json#/$defs/SourceRef" },
    "ManifestEntry": { "$ref": "ir.schema.json#/$defs/ManifestEntry" },
    "EffortMapping": {
      "description": "What the requested effort became for this provider and model. Added in feature 002; provider_value is an integer where the control is a token budget.",
      "type": "object", "additionalProperties": false,
      "required": ["requested", "provider_param", "provider_value"],
      "properties": {
        "requested": { "enum": ["low", "medium", "high", "xhigh"] },
        "provider_param": { "type": "string" },
        "provider_value": { "type": ["string", "integer"] }
      }
    },
    "ProviderInfo": {
      "description": "Which provider ran this review and how its effort control was set. Added in feature 002; absent on sessions written before it.",
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "effort_mapping", "key_source"],
      "properties": {
        "provider": { "enum": ["openai", "gemini", "fake"] },
        "model": { "type": "string" },
        "effort_mapping": { "$ref": "#/$defs/EffortMapping" },
        "key_source": { "enum": ["settings", "env", "none"] }
      }
    },
    "TokenUsage": {
      "description": "What one model round trip cost, in the fields the provider actually reported. Added in feature 005. Every count is nullable because a field the endpoint omitted is unknown, not zero (Principle I), and the two providers' sub-counts nest differently and are never summed across them: reasoning_tokens is inside output_tokens on OpenAI and a separate addend of the total on Gemini, and tool_result_input_tokens is inside input_tokens on OpenAI and outside it on Gemini. total_tokens is the only field a cross-provider comparison may use. Derived values (uncached_input_tokens, cached_input_share) are properties in code and are not stored here, so they cannot go stale.",
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "cache_write_tokens", "output_tokens", "reasoning_tokens", "tool_result_input_tokens", "total_tokens", "latency_s"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Contained inside input_tokens on both providers" },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "OpenAI only; null on Gemini and on an endpoint that does not report it" },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tool_result_input_tokens": { "type": ["integer", "null"], "minimum": 0, "description": "Gemini only; the same tokens are already inside input_tokens on OpenAI" },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_s": { "type": "number", "minimum": 0, "description": "Wall clock measured by the adapter around its own request. Never null: if we made the call, we timed it" }
      }
    },
    "SessionUsage": {
      "description": "What this whole run cost, summed from the usage events of every model round trip. Added in feature 005; absent on sessions written before it, and null rather than an all-zero record when the adapter reported nothing. The summing rule is that any null in any round makes that total null, never a partial sum.",
      "type": "object", "additionalProperties": false,
      "required": ["rounds", "turns", "totals", "by_turn"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 0, "description": "Model round trips, not tool calls" },
        "turns": { "type": "integer", "minimum": 0, "description": "Turns that produced at least one round, delimited by the turn.ended events" },
        "totals": { "$ref": "#/$defs/TokenUsage" },
        "by_turn": { "type": "array", "items": { "$ref": "#/$defs/TokenUsage" } }
      }
    },
    "EfficiencySettings": {
      "description": "Which efficiency levers this run had on. Added in feature 005; absent on sessions written before it. Every lever defaults to off and no lever is a pane setting (FR-021).",
      "type": "object", "additionalProperties": false,
      "required": ["trim_tool_descriptions", "tool_tiers", "prompt_cache_key", "gemini_explicit_cache", "prerun_checks", "parallel_tool_calls", "coverage_stop", "package_reuse", "lazy_meshes", "carry_over_rms"],
      "properties": {
        "trim_tool_descriptions": { "type": "boolean" },
        "tool_tiers": { "type": "boolean" },
        "prompt_cache_key": { "type": "boolean" },
        "gemini_explicit_cache": { "type": "boolean" },
        "prerun_checks": { "type": "boolean" },
        "parallel_tool_calls": { "type": "boolean" },
        "coverage_stop": { "type": "boolean" },
        "package_reuse": { "type": "boolean" },
        "lazy_meshes": { "type": "boolean" },
        "carry_over_rms": { "type": "boolean" },
        "procedural_gate": { "type": "boolean", "description": "Lever 11, added in feature 007. Declared here and deliberately left out of `required`: a session written before it existed carries ten booleans and must still validate." },
        "compact_queries": { "type": "boolean", "description": "Experimental bounded package discovery pages. Optional and deliberately left out of `required` so sessions written before the experiment still validate." }
      }
    },
    "InvestigationStep": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "tool", "arguments", "result_summary", "status", "error", "elapsed_s"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 }, "tool": { "type": "string" },
        "arguments": { "type": "object" }, "result_summary": { "type": "string" },
        "status": { "enum": ["ok", "error"] }, "error": { "type": ["string", "null"] },
        "elapsed_s": { "type": "number", "minimum": 0 }
      }
    },
    "EvidenceRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "what", "why", "entity_ids", "status", "answer", "answered_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^ER-[0-9]{3,}$" }, "what": { "type": "string" }, "why": { "type": "string" },
        "entity_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["open", "answered"] }, "answer": { "type": ["string", "null"] },
        "answered_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Calculation": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "inputs", "assumptions", "excluded_effects", "result", "units_out", "function", "function_version"],
      "properties": {
        "model": { "type": "string" },
        "inputs": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/Quantity" }, { "$ref": "#/$defs/Angle" }, { "type": "string" }] } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "excluded_effects": { "type": "array", "items": { "type": "string" } },
        "result": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/Quantity" }, { "type": "boolean" }, { "type": "string" }, { "type": "number" }] } },
        "units_out": { "type": "string" }, "function": { "type": "string" }, "function_version": { "type": "string" }
      }
    },
    "Disposition": {
      "type": "object", "additionalProperties": false, "required": ["decision", "note", "by", "at"],
      "properties": { "decision": { "enum": ["accepted", "rejected", "deferred"] }, "note": { "type": "string" }, "by": { "type": "string" }, "at": { "type": "string", "format": "date-time" } }
    },
    "Finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "check", "title", "status", "severity", "component_ids", "drawing_locations", "provenance", "configuration", "observed", "requirement", "inputs", "calculation", "tool_result_ids", "coverage_limits", "recommended_action", "group", "capture_ids", "disposition", "exception_id"],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" }, "check": { "type": "string" }, "title": { "type": "string" },
        "status": { "enum": ["demonstrated", "suspected", "unresolved", "checked_within_scope"] },
        "severity": { "enum": ["high", "medium", "low", "info"] },
        "component_ids": { "type": "array", "items": { "type": "string" } },
        "drawing_locations": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ManifestEntry" } },
        "configuration": { "type": "string" }, "observed": { "type": "string" }, "requirement": { "type": "string" },
        "inputs": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/Dimension" }, { "$ref": "#/$defs/Quantity" }, { "type": "string" }] } },
        "calculation": { "anyOf": [{ "$ref": "#/$defs/Calculation" }, { "type": "null" }] },
        "tool_result_ids": { "type": "array", "items": { "type": "integer" } },
        "coverage_limits": { "type": "array", "items": { "type": "string" } },
        "recommended_action": { "type": "string" },
        "group": { "anyOf": [{ "type": "object", "additionalProperties": false, "required": ["key", "member_component_ids"],
          "properties": { "key": { "type": "string" }, "member_component_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } } } }, { "type": "null" }] },
        "capture_ids": { "type": "array", "items": { "type": "string" } },
        "disposition": { "anyOf": [{ "$ref": "#/$defs/Disposition" }, { "type": "null" }] },
        "exception_id": { "type": ["string", "null"] },
        "carried_over_from": { "type": ["string", "null"], "format": "uuid", "description": "The session that produced this verdict, when this run carried it over instead of computing it; null when this run computed it (feature 005, lever 11a)" },
        "carried_over_at": { "type": ["string", "null"], "format": "date-time", "description": "When the carry-over decision was made, not when the verdict was first produced" },
        "carry_over_key": { "type": ["string", "null"], "description": "The key that justified the carry-over, stored so the decision is reproducible by hand against the package" }
      },
      "allOf": [
        { "anyOf": [{ "properties": { "component_ids": { "minItems": 1 } } }, { "properties": { "drawing_locations": { "minItems": 1 } } }] },
        { "if": { "properties": { "status": { "enum": ["demonstrated", "checked_within_scope"] } } },
          "then": { "anyOf": [{ "properties": { "calculation": { "type": "object" } } }, { "properties": { "tool_result_ids": { "minItems": 1 } } }] } },
        { "if": { "properties": { "status": { "const": "unresolved" } } },
          "then": { "properties": { "coverage_limits": { "minItems": 1 } } } }
      ]
    },
    "CoverageItem": {
      "type": "object", "additionalProperties": false, "required": ["check", "scope", "reason", "error"],
      "properties": {
        "check": { "type": "string" },
        "scope": { "type": "object", "additionalProperties": false,
          "properties": {
            "component_ids": { "type": "array", "items": { "type": "string" } },
            "pairs": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
            "configuration": { "type": ["string", "null"] },
            "positions": { "type": "array", "items": { "type": "string" } },
            "document_ids": { "type": "array", "items": { "type": "string" } }
          } },
        "reason": { "type": "string" }, "error": { "type": ["string", "null"] }
      }
    },
    "Coverage": {
      "type": "object", "additionalProperties": false, "required": ["checked", "skipped", "unresolved", "failed", "out_of_scope"],
      "properties": {
        "checked": { "type": "array", "items": { "$ref": "#/$defs/CoverageItem" } },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/CoverageItem" } },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/CoverageItem" } },
        "failed": { "type": "array", "items": { "$ref": "#/$defs/CoverageItem" } },
        "out_of_scope": { "type": "array", "items": { "$ref": "#/$defs/CoverageItem" } }
      }
    },
    "Timing": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_minutes", "assisted_supervision_minutes", "assisted_verification_minutes", "false_alarm_handling_minutes", "unattended_runtime_minutes", "net_saved_minutes"],
      "properties": {
        "baseline_minutes": { "type": ["number", "null"], "minimum": 0 },
        "assisted_supervision_minutes": { "type": "number", "minimum": 0 },
        "assisted_verification_minutes": { "type": "number", "minimum": 0 },
        "false_alarm_handling_minutes": { "type": "number", "minimum": 0 },
        "unattended_runtime_minutes": { "type": "number", "minimum": 0 },
        "net_saved_minutes": { "type": ["number", "null"] }
      }
    }
  }
}
